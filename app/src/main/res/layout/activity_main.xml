<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Кнопки Включения/Выключения -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Включить фильтр"
            android:backgroundTint="#4CAF50" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Выключить"
            android:backgroundTint="#9E9E9E"
            android:enabled="false" />
    </LinearLayout>
    
    <Button
            android:id="@+id/btnQueries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Включить запись запросов" />
    <!-- Счетчик заблокированных DoT запросов -->
    <TextView
        android:id="@+id/tvStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:text="Блокировка системного DNS (DoT): 0"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textColor="#FF5722"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Отметьте программы-исключения (их трафик пойдет мимо фильтра):"
        android:textStyle="bold" />

    <!-- Поле поиска -->
    <EditText
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Поиск по названию..."
        android:inputType="text"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:background="@android:drawable/editbox_background"
        android:singleLine="true" />

    <!-- Список программ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
